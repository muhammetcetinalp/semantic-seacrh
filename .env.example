# ==============================================================================
# SEMANTIC SEARCH ENGINE — ÇEVRE DEĞİŞKENLERİ (.env)
# ==============================================================================
# Bu dosyayı .env adıyla kopyalayıp ihtiyaçlarınıza göre düzenleyin:
# cp .env.example .env
# ==============================================================================

# ── 1. POSTGRESQL VERİTABANI (Durum Takibi & Sorgu Logları) ────────────────────
# docker compose up ile ayağa kalkan PostgreSQL 16-alpine konteynerine bağlanır.
DB_USERNAME=semantic_search
DB_PASSWORD=SearchDev2026
DB_HOST=localhost
DB_PORT=5432
DB_NAME=semantic_search

# ── 2. OPENSEARCH (BM25 + Dense Vektör Deposu) ─────────────────────────────────
# docker compose up ile ayağa kalkan OpenSearch 3.8.0 motoruna bağlanır.
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=http
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# ── 3. QDRANT (ColBERT Token-Level Multi-Vector Store) ─────────────────────────
# docker compose up ile ayağa kalkan Qdrant motoruna bağlanır.
# ColBERT MaxSim çoklu vektör araması burada donanım hızlandırmalı çalışır.
SEARCH_QDRANT_ENABLED=true
SEARCH_QDRANT_ENDPOINT=http://localhost:6333
SEARCH_QDRANT_COLLECTION=colbert_olaylar
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ── 4. EMBEDDING SAĞLAYICI (Dense Vektörler / BGE-M3) ──────────────────────────
# Seçenek A: REST / OLLAMA (Önerilen Gerçek Model — 1024 boyutlu BGE-M3)
#   Kurulum: brew install ollama && ollama pull bge-m3
EMBEDDING_PROVIDER=rest
EMBEDDING_MOCK_ENABLED=false
EMBEDDING_ENDPOINT=http://localhost:11434/v1/embeddings
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# Seçenek B: MOCK (Harici model/GPU gerektirmeyen anında test modu)
#   Ollama olmadan çalıştırmak için aşağıdaki satırları aktif edin:
# EMBEDDING_PROVIDER=mock
# EMBEDDING_MOCK_ENABLED=true
# EMBEDDING_DIMENSIONS=384

# ── 5. COLBERT (Late Interaction Çoklu Vektör Arama) ───────────────────────────
# %100 Saf Java motoru (Python veya GPU gerektirmez).
SEARCH_COLBERT_ENABLED=true
SEARCH_COLBERT_PROVIDER=java
SEARCH_COLBERT_MODEL=jinaai/jina-colbert-v2
SEARCH_COLBERT_STORAGE=qdrant

# ── 6. RERANKER (Cross-Encoder Yeniden Sıralama) ───────────────────────────────
# Seçenek A: java (%100 Saf Java içi reranker — harici bağımlılık YOK, 1-2 ms)
SEARCH_RERANKING_ENABLED=true
SEARCH_RERANKING_PROVIDER=java
SEARCH_RERANKING_MODEL=BAAI/bge-reranker-v2-m3

# Seçenek B: ollama (Ollama üzerinden reranking)
# SEARCH_RERANKING_PROVIDER=ollama
# SEARCH_RERANKING_ENDPOINT=http://localhost:11434

# ── 7. KAFKA (Asenkron Olay Akışı & Canlı İndeksleme Simülasyonu) ─────────────
SEARCH_KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SEARCH_KAFKA_TOPICS=olaylar-events
KAFKA_PORT=9092

# ── 8. SUNUCU & GÜVENLİK ───────────────────────────────────────────────────────
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 9. ARAMA & RRF LİMİTLERİ (Varsayılanlar) ──────────────────────────────────────
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=100
SEARCH_DEFAULT_INDEX=olaylar
