# ==============================================================================
# SEMANTIC SEARCH ENGINE — ÇEVRE DEĞİŞKENLERİ (.env)
# ==============================================================================
# Bu dosyayı .env adıyla kopyalayıp ihtiyaçlarınıza göre düzenleyin:
# cp .env.example .env
# ==============================================================================

# ── 1. POSTGRESQL VERİTABANI (Durum Takibi & Sorgu Logları) ────────────────────
# Uzaktaki PostgreSQL 17 sunucunuzun IP adresini veya hostname'ini yazın.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=semantic_search
DB_USERNAME=semantic_search
DB_PASSWORD=SearchDev2026
DB_SCHEMA=public

# İsteğe bağlı ek JDBC parametreleri (örn: Airgap ağda SSL yoksa '?sslmode=disable')
DB_PARAMS=

# Alternatif: Tüm JDBC URL'ini tek satırda vermek isterseniz aşağıdaki satırı açın (üsttekileri ezer):
# DB_URL=jdbc:postgresql://192.168.1.100:5432/semantic_search?sslmode=disable

# Veritabanı Bağlantı Havuzu (HikariCP) & Flyway Ayarları
DB_CONNECTION_TIMEOUT=30000
DB_MAX_POOL_SIZE=10
FLYWAY_ENABLED=true

# ── 2. OPENSEARCH (BM25 + Dense Vektör Deposu) ─────────────────────────────────
# Aşama 1: Windows istemci makinede yerel çalışıyorsa 'localhost'
# Aşama 2: Airgap ağdaki uzak OpenSearch sunucusuna taşındığında o sunucunun IP'sini yazın (örn: 192.168.1.60)
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=http
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_CONNECT_TIMEOUT=5000
OPENSEARCH_SOCKET_TIMEOUT=60000

# ── 3. HARİCİ MODEL SUNUCUSU (API Key) ────────────────────────────────────────
# Ortak API Anahtarı (Hem Embedding hem Reranker için geçerlidir):
AI_API_KEY=

# ── 4. EMBEDDING SAĞLAYICI (Dense Vektörler / BGE-M3) ──────────────────────────
# Seçenek A: Uzak Airgap Sunucusu (REST / OpenAI / vLLM / FastEmbed uyumlu endpoint)
EMBEDDING_PROVIDER=rest
EMBEDDING_MOCK_ENABLED=false
EMBEDDING_ENDPOINT=https://model-server.airgap.lan/v1/embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
# İsteğe bağlı: Embedding için özel API Key (AI_API_KEY'i ezer):
EMBEDDING_API_KEY=
EMBEDDING_API_KEY_HEADER=Authorization

# Seçenek B: MOCK (Harici model/GPU gerektirmeyen anında test modu)
#   Model sunucusu olmadan çalıştırmak için aşağıdaki satırları aktif edin:
# EMBEDDING_PROVIDER=mock
# EMBEDDING_MOCK_ENABLED=true
# EMBEDDING_DIMENSIONS=384

# ── 5. RERANKER (Cross-Encoder Yeniden Sıralama) ───────────────────────────────
# Seçenek A: tei (Hugging Face TEI / Infinity / REST Cross-Encoder Modeli)
SEARCH_RERANKING_ENABLED=true
SEARCH_RERANKING_PROVIDER=tei
SEARCH_RERANKING_ENDPOINT=https://model-server.airgap.lan/rerank
SEARCH_RERANKING_MODEL=BAAI/bge-reranker-v2-m3
# İsteğe bağlı: Reranker için özel API Key (AI_API_KEY'i ezer):
SEARCH_RERANKING_API_KEY=
SEARCH_RERANKING_API_KEY_HEADER=Authorization
RERANKER_PORT=8082

# ── 5. KAFKA (Kubernetes & Asenkron Olay Akışı) ─────────────────────────────────
SEARCH_KAFKA_ENABLED=true
# Airgap Kubernetes ortamındaki Kafka NodePort veya LoadBalancer adresini yazın:
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=semantic-search-indexer
KAFKA_AUTO_OFFSET_RESET=earliest
# Dinlenecek topic(ler) — birden fazlaysa virgülle ayırın:
SEARCH_KAFKA_TOPICS=olaylar-events
SEARCH_KAFKA_DEAD_LETTER_TOPIC=olaylar.indexing.errors
SEARCH_KAFKA_CONCURRENCY=2

# İsteğe Bağlı: Kubernetes Kafka SASL kimlik doğrulama kullanıyorsa aktif edin:
# SPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL=SASL_PLAINTEXT
# SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=SCRAM-SHA-512
# SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="user" password="password";

# ── 6. SUNUCU & GÜVENLİK ───────────────────────────────────────────────────────
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 7. ARAMA & RRF LİMİTLERİ (Varsayılanlar) ──────────────────────────────────────
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=100
SEARCH_DEFAULT_INDEX=olaylar
